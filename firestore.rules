rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Personal journal data remains private to its owner.
    match /users/{userId} {
      allow read, create, update, delete: if request.auth != null && request.auth.uid == userId;
      match /{document=**} {
        allow read, create, update, delete: if request.auth != null && request.auth.uid == userId;
      }
    }
    // Searchable account names only; no email addresses or journal records.
    match /publicProfiles/{userId} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null && request.auth.uid == userId
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['uid', 'displayName', 'displayNameLower', 'updatedAt']);
      allow delete: if request.auth != null && request.auth.uid == userId;
    }
    // Aggregate progress is readable only by the owner or people they follow.
    match /userProgress/{userId} {
      allow create, update: if request.auth != null && request.auth.uid == userId
        && request.resource.data.uid == request.auth.uid;
      allow read: if request.auth != null && (request.auth.uid == userId
        || (exists(/databases/$(database)/documents/follows/$(request.auth.uid + '_' + userId))
          && exists(/databases/$(database)/documents/follows/$(userId + '_' + request.auth.uid))));
      allow delete: if request.auth != null && request.auth.uid == userId;
    }
    // A follow edge is created/deleted by the follower; both sides can read it.
    match /follows/{followId} {
      allow read: if request.auth != null && (resource.data.followerUid == request.auth.uid || resource.data.followedUid == request.auth.uid);
      allow create: if request.auth != null && request.resource.data.followerUid == request.auth.uid
        && request.resource.data.followedUid is string && request.resource.data.followedUid != request.auth.uid
        && request.resource.data.keys().hasOnly(['followerUid', 'followedUid', 'createdAt']);
      allow delete: if request.auth != null && resource.data.followerUid == request.auth.uid;
      allow update: if false;
    }
    match /{document=**} { allow read, write: if false; }
  }
}