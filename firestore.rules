rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Personal journal data remains private to its owner.
    match /users/{userId} {
      allow read, create, update, delete: if request.auth != null && request.auth.uid == userId;
      match /{document=**} {
        allow read, create, update, delete: if request.auth != null && request.auth.uid == userId;
      }
    }
      // Notifications are private to the recipient; mutual friends may create only limited activity events.
      match /notifications/{notificationId} {
        allow read, delete: if request.auth != null && request.auth.uid == userId;
        allow update: if request.auth != null && request.auth.uid == userId
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
        allow create: if request.auth != null
          && request.auth.uid != userId
          && request.resource.data.actorUid == request.auth.uid
          && request.resource.data.read == false
          && request.resource.data.type in ['book_started', 'book_finished', 'all_non_negotiables', 'streak_milestone', 'level_up', 'achievement', 'weekly_summary']
          && request.resource.data.keys().hasOnly(['type', 'actorUid', 'actorName', 'eventKey', 'read', 'createdAt', 'bookTitle', 'bookAuthor', 'message'])
          && exists(/databases/$(database)/documents/follows/$(request.auth.uid + '_' + userId))
          && exists(/databases/$(database)/documents/follows/$(userId + '_' + request.auth.uid))
          && ((request.resource.data.type in ['book_started', 'book_finished']
              && exists(/databases/$(database)/documents/users/$(request.auth.uid)/settings/privacy)
              && get(/databases/$(database)/documents/users/$(request.auth.uid)/settings/privacy).data.shareReadingActivity == true)
            || (request.resource.data.type in ['all_non_negotiables', 'streak_milestone', 'level_up', 'achievement', 'weekly_summary']
              && (!exists(/databases/$(database)/documents/users/$(request.auth.uid)/settings/privacy)
                || get(/databases/$(database)/documents/users/$(request.auth.uid)/settings/privacy).data.shareProgress != false)));
      }
    // Searchable account names only; no email addresses or journal records.
    match /publicProfiles/{userId} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null && request.auth.uid == userId
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['uid', 'displayName', 'displayNameLower', 'updatedAt']);
      allow delete: if request.auth != null && request.auth.uid == userId;
    }
    // Aggregate progress is readable only by the owner or people they follow.
    match /userProgress/{userId} {
      // Only the account owner can publish a limited set of aggregate progress fields.
      // Never expose email addresses, book details, habit names, or journal entries here.
      allow create, update: if request.auth != null && request.auth.uid == userId
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly([
          'uid', 'displayName', 'totalXp', 'totalActions', 'level', 'rank',
          'streak', 'todayCompleted', 'todayDue', 'shareProgress', 'updatedAt'
        ]);
      allow read: if request.auth != null && (request.auth.uid == userId
        || (resource.data.shareProgress != false
          && exists(/databases/$(database)/documents/follows/$(request.auth.uid + '_' + userId))
          && exists(/databases/$(database)/documents/follows/$(userId + '_' + request.auth.uid))));
      allow delete: if request.auth != null && request.auth.uid == userId;
    }
    // Notification recipients can read and manage their own notifications.
    // A mutual friend may create only a limited, privacy-respecting activity notification.
    match /users/{userId}/notifications/{notificationId} {
      allow read, update, delete: if request.auth != null && request.auth.uid == userId;
      allow create: if request.auth != null
        && request.resource.data.actorUid == request.auth.uid
        && request.resource.data.keys().hasOnly([
          'type', 'actorUid', 'actorName', 'eventKey', 'read', 'createdAt',
          'bookTitle', 'bookAuthor', 'message'
        ])
        && request.resource.data.type in [
          'all_non_negotiables', 'streak_milestone', 'level_up', 'achievement',
          'book_started', 'book_finished'
        ]
        && request.resource.data.eventKey is string
        && request.resource.data.read == false
        && exists(/databases/$(database)/documents/follows/$(request.auth.uid + '_' + userId))
        && exists(/databases/$(database)/documents/follows/$(userId + '_' + request.auth.uid))
        && (
          (request.resource.data.type in ['book_started', 'book_finished']
            && exists(/databases/$(database)/documents/users/$(request.auth.uid)/settings/privacy)
            && get(/databases/$(database)/documents/users/$(request.auth.uid)/settings/privacy).data.shareReadingActivity == true)
          ||
          (request.resource.data.type in ['all_non_negotiables', 'streak_milestone', 'level_up', 'achievement']
            && (!exists(/databases/$(database)/documents/users/$(request.auth.uid)/settings/privacy)
              || get(/databases/$(database)/documents/users/$(request.auth.uid)/settings/privacy).data.shareProgress != false))
        );
    }
    // A follow edge is created/deleted by the follower; both sides can read it.
    match /follows/{followId} {
      allow read: if request.auth != null && (resource.data.followerUid == request.auth.uid || resource.data.followedUid == request.auth.uid);
      allow create: if request.auth != null && request.resource.data.followerUid == request.auth.uid
        && request.resource.data.followedUid is string && request.resource.data.followedUid != request.auth.uid
        && request.resource.data.keys().hasOnly(['followerUid', 'followedUid', 'createdAt']);
      allow delete: if request.auth != null && resource.data.followerUid == request.auth.uid;
      allow update: if false;
    }
    match /{document=**} { allow read, write: if false; }
  }
}